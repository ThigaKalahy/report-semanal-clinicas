# ─── Supabase ────────────────────────────────────────────────────────────────
# URL pública do projeto Supabase (visível no browser)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Chave anônima (pública) do Supabase — usada no cliente browser e SSR
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Chave de serviço (secreta) — usada apenas no servidor para operações admin
# NUNCA exponha esta chave no cliente
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Autenticação da aplicação ───────────────────────────────────────────────
# Senha simples para proteger o acesso interno da ferramenta
APP_PASSWORD=minha-senha-segura

# ─── Google Sheets (Service Account) ─────────────────────────────────────────
# JSON da service account do Google Cloud em UMA ÚNICA LINHA (minificado).
# Para minificar: jq -c . < minha-service-account.json
# A service account precisa ter acesso de Leitura a cada planilha usada.
# Compartilhe cada sheet com o client_email da service account.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}

# ─── Google Places API ────────────────────────────────────────────────────────
# Chave de API do Google Cloud com Places API habilitada
# Usada para buscar avaliações e nota média das clínicas no Google Maps
GOOGLE_PLACES_API_KEY=AIza...
